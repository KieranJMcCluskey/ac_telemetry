# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=eyJ...        # public anon key (safe to expose)
SUPABASE_SERVICE_KEY=eyJ...     # service role key — NEVER expose client-side

# Anthropic
ANTHROPIC_API_KEY=sk-ant-...

# Stripe
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_10=price_...       # Stripe Price ID for 10-token pack ($5)
STRIPE_PRICE_100=price_...      # Stripe Price ID for 100-token pack ($45)

# Site
SITE_URL=https://your-site.netlify.app

# Upstash Redis (for rate limiting) — optional but recommended
UPSTASH_REDIS_REST_URL=https://...upstash.io
UPSTASH_REDIS_REST_TOKEN=...
